# Copy this file to .env and fill it in.

# The password of the database. Change it.
POSTGRES_PASSWORD=change-me

# Needed to keep the text of production traces, and for online checks.
# Make one with:  docker compose run --rm api trustbench secrets generate-key
TRUSTBENCH_SECRET_KEY=

# Only for many workers on a busy queue: start with --profile scale and set
# TRUSTBENCH_REDIS_URL=redis://redis:6379/0

# Keys of the model providers you want to test.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
